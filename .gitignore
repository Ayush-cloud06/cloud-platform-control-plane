# Terraform working directories and state (state can contain secrets)
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
*.plan

# This repo is a reusable module; consumers own provider locking.
.terraform.lock.hcl

# Variable files may hold account-specific values; commit *.tfvars.example instead.
*.tfvars
*.tfvars.json
!*.tfvars.example

override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Secrets
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Scanner output
results.sarif

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.iml
